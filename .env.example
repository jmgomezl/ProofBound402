PORT=4402
HEDERA_NETWORK=testnet

# Leave every credential empty to use the deterministic evidence simulator.
# Live mode requires three distinct funded testnet accounts so Mirror Node can
# prove the transfer amount independently from facilitator fees.
HEDERA_PAYER_ACCOUNT_ID=
HEDERA_PAYER_PRIVATE_KEY=
HEDERA_FACILITATOR_ACCOUNT_ID=
HEDERA_FACILITATOR_PRIVATE_KEY=
PROOFBOUND_PAY_TO=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
PROOFBOUND_RESOURCE_BASE_URL=http://localhost:4402

# Resource-server settlement configuration.
PROOFBOUND_ASSET=0.0.0
PROOFBOUND_AMOUNT=1000000
PROOFBOUND_CHALLENGE_TTL_SECONDS=120

# Explicit opt-in for the integration test that transfers testnet funds.
RUN_HEDERA_LIVE_TESTS=0

# Added in issue #2. Leave empty until HCS receipt publication is configured.
HEDERA_HCS_TOPIC_ID=
