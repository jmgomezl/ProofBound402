{
  "name": "proofbound402",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch src/server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "setup:testnet": "node scripts/provision-testnet.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:live": "RUN_HEDERA_LIVE_TESTS=1 node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.config.ts src/server/live-settlement.integration.test.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hiero-ledger/sdk": "2.89.1",
    "@x402/core": "2.28.0",
    "@x402/hedera": "2.28.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "ethers": {
      "ws": "8.21.1"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
